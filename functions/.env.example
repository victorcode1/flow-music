# Cloud Functions environment variables
# Copia este archivo como `.env.<tu-firebase-project-id>` (ej. `.env.flowmusic-5715a`)
# y rellena los valores antes de desplegar las funciones.

# Lista de emails separados por coma autorizados a auto-asignarse el claim
# `locationAdmin` desde la app (bootstrap del dashboard admin de ubicación).
# Dejar vacío para deshabilitar el bootstrap por completo.
BOOTSTRAP_LOCATION_ADMIN_EMAILS=

# Web API key del proyecto Firebase. Se usa solo en el backend para llamar la
# REST API de Firebase Auth sin exponer Firebase SDK en el cliente Flutter.
AUTH_WEB_API_KEY=
