# Firebase per-platform config (generated by `flutterfire configure`)
# Public repo rule: never commit these to branch `1.0.0` or remote `organization`.
# Private backup exception: these are force-added only on branch `private/full-backup`
# and pushed only to the private personal repo.
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

# API key files
# Public repo rule: never commit real environment files.
# Keep only example files such as `functions/.env.example`.
**/apikeys.dart
.env
.env.*
**/.env
**/.env.*
**/.runtimeconfig.json
**/.envrc
!*.env.example

# Local clones of Radio Browser upstream repositories.
# These are working copies only; commit the generated bundles in `radio-bundles/`.
/radio/
/radio-restored/
/radio-bundles/*.tmp
