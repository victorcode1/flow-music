rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.locationAdmin == true
      );
    }

    function isAnonymousAuth() {
      return signedIn() &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function ownerProfileFields() {
      return [
        'email',
        'displayName',
        'photoUrl',
        'isAnonymous',
        'createdAt',
        'updatedAt',
        'lastLocation',
        'hasLocation',
        'isOnline',
        'appState',
        'activeSessionId',
        'lastOpenedAt',
        'lastSeenAt',
        'lastOnlineAt',
        'lastOfflineAt',
        'presenceUpdatedAt',
        'openCount',
        'appVersion',
        'buildNumber',
        'platform',
        'deviceLocale',
        'timezoneName',
        'timezoneOffsetMinutes',
        'campaignSegments'
      ];
    }

    function adminUserUpdateFields() {
      return [
        'locationUpdateIntervalMinutes',
        'updatedAt'
      ];
    }

    function createsOnly(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(uid) && createsOnly(ownerProfileFields());
      allow update: if (
        isOwner(uid) && changesOnly(ownerProfileFields())
      ) || (
        isAdmin() && changesOnly(adminUserUpdateFields())
      );
      allow delete: if false;

      match /profile/settings {
        allow read, write: if isOwner(uid);
      }

      match /favorites/{favoriteId} {
        allow read, write: if isOwner(uid) && !isAnonymousAuth();
      }

      match /playlists/{playlistId} {
        allow read, write: if isOwner(uid) && !isAnonymousAuth();
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid);
        allow delete: if false;
      }

      match /locationHistory/{entryId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /settings/locationHistoryCleanup {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /settings/locationTracking {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
