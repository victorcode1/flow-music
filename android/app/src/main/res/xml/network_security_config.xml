<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Internet-radio providers use a dynamic set of hosts, and many still
         expose only HTTP streams. API and app traffic continue to prefer HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
